# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins allowed to call the API (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database — Microsoft SQL Server (default)
# ---------------------------------------------------------------------------
DB_ENGINE=mssql
DB_NAME=pathforge
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server

# SQL Server authentication. Leave DB_USER blank to use Windows integrated auth.
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_TRUST_SERVER_CERTIFICATE=yes

# Set DB_ENGINE=sqlite to run without SQL Server (local development only)

# ---------------------------------------------------------------------------
# JWT lifetimes (minutes / days)
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
