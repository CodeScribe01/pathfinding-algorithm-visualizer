# Base URL of the Django REST API (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Repository link surfaced in the navbar + footer
VITE_GITHUB_URL=https://github.com/CodeScribe01/pathfinding-algorithm-visualizer

# Set to "false" to disable automatic persistence of completed runs
VITE_AUTOSAVE_RUNS=true

# Set to "true" for a static build with no API behind it (GitHub Pages). Hides
# the account-backed routes instead of letting them fail against a missing API.
VITE_DEMO_MODE=false

# Subpath the app is served from. "/" locally; "/<repo>/" for a GitHub Pages
# project site. Read by vite.config.js at build time.
VITE_BASE_PATH=/
